<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Blog.Admin.Api</RootNamespace>
    <AssemblyName>Blog.Admin.Api</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      The private KeshavSingh.* feed needs PACKAGES_READ_TOKEN. When it is absent we skip those
      references so restore can't 401. This deterministically covers GitHub's hosted automatic
      NuGet dependency submission (which has no access to repo secrets), while the real Docker /
      Render build — which exports PACKAGES_READ_TOKEN before restore — still includes them.
    -->
    <UseLocalProjectReferences Condition="'$(UseLocalProjectReferences)' == '' and Exists('..\..\..\shared-security\src\KeshavSingh.Security\KeshavSingh.Security.csproj')">true</UseLocalProjectReferences>
    <SkipPrivatePackages Condition="'$(UseLocalProjectReferences)' == 'true' or '$(PACKAGES_READ_TOKEN)' == ''">true</SkipPrivatePackages>
  </PropertyGroup>

  <ItemGroup>
    <!-- MongoDB access: required, the application's database driver. -->
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <!-- JWT bearer validation for OAuth2-style bearer tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- API documentation for the admin API surface. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Server-side QR generation for TOTP enrollment. Keeps the shared secret
         on the server instead of leaking it to a third-party QR service. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(SkipPrivatePackages)' != 'true'">
    <!-- Shared security + auth packages from GitHub Packages. Restore reads the "github"
         source in the repo-root nuget.config, which needs the PACKAGES_READ_TOKEN env var.
         GitHub's hosted automatic NuGet dependency submission job cannot read this private
         feed, so that specific job skips these references instead of failing restore. -->
    <PackageReference Include="KeshavSingh.Security" Version="0.5.0" />
    <PackageReference Include="KeshavSingh.Auth" Version="0.7.0" />
    <PackageReference Include="KeshavSingh.Mongo.NoSql" Version="0.3.0" />
    <PackageReference Include="KeshavSingh.Realtime" Version="0.7.0" />
    <PackageReference Include="KeshavSingh.Core" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(SkipPrivatePackages)' == 'true'">
    <ProjectReference Include="..\..\..\shared-security\src\KeshavSingh.Security\KeshavSingh.Security.csproj" />
    <ProjectReference Include="..\..\..\shared-security\src\KeshavSingh.Auth\KeshavSingh.Auth.csproj" />
    <ProjectReference Include="..\..\..\KeshavSingh-Packages-Nosql\src\KeshavSingh.Mongo.NoSql\KeshavSingh.Mongo.NoSql.csproj" />
    <ProjectReference Include="..\..\..\KeshavSingh-Packages-Realtime\src\KeshavSingh.Realtime\KeshavSingh.Realtime.csproj" />
    <ProjectReference Include="..\..\..\KeshavSingh-Packages-Core\src\KeshavSingh.Core\KeshavSingh.Core.csproj" />
  </ItemGroup>

</Project>
