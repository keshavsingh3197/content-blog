<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Blog.Admin.Api</RootNamespace>
    <AssemblyName>Blog.Admin.Api</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      The private KeshavSingh.* feed needs PACKAGES_READ_TOKEN. Three distinct situations, so
      two independent switches rather than one fused flag:

        siblings on disk      -> UseLocalProjectReferences: build against the sibling source
                                 (parent CLAUDE.md: local checkouts win over published packages).
        no siblings, token    -> restore the published packages from GitHub Packages.
        no siblings, no token -> SkipPrivatePackages: omit the references entirely so restore
                                 cannot 401. This is what GitHub's hosted automatic NuGet
                                 dependency submission job hits - it restores but never builds,
                                 so the missing references are harmless there.

      Pass -p:UseLocalProjectReferences=false to force a real registry restore.
    -->
    <UseLocalProjectReferences Condition="'$(UseLocalProjectReferences)' == '' and Exists('..\..\..\shared-security\src\KeshavSingh.Security\KeshavSingh.Security.csproj')">true</UseLocalProjectReferences>
    <UseLocalProjectReferences Condition="'$(UseLocalProjectReferences)' == ''">false</UseLocalProjectReferences>
    <SkipPrivatePackages Condition="'$(UseLocalProjectReferences)' != 'true' and '$(PACKAGES_READ_TOKEN)' == ''">true</SkipPrivatePackages>
    <SkipPrivatePackages Condition="'$(SkipPrivatePackages)' == ''">false</SkipPrivatePackages>
  </PropertyGroup>

  <ItemGroup>
    <!-- MongoDB access: required, the application's database driver. -->
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <!-- JWT bearer validation for OAuth2-style bearer tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- API documentation for the admin API surface. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true' and '$(SkipPrivatePackages)' != 'true'">
    <!-- Shared security + auth packages from GitHub Packages. Restore reads the "github"
         source in the repo-root nuget.config, which needs the PACKAGES_READ_TOKEN env var.
         Used only when there is no sibling checkout and a token is present; see the
         PropertyGroup above for the other two cases. -->
    <PackageReference Include="KeshavSingh.Security" Version="0.6.0" />
    <PackageReference Include="KeshavSingh.Auth" Version="0.10.0" />
    <PackageReference Include="KeshavSingh.Mongo.NoSql" Version="0.4.0" />
    <PackageReference Include="KeshavSingh.Core" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\shared-security\src\KeshavSingh.Security\KeshavSingh.Security.csproj" />
    <ProjectReference Include="..\..\..\shared-security\src\KeshavSingh.Auth\KeshavSingh.Auth.csproj" />
    <ProjectReference Include="..\..\..\KeshavSingh-Packages-Nosql\src\KeshavSingh.Mongo.NoSql\KeshavSingh.Mongo.NoSql.csproj" />
    <ProjectReference Include="..\..\..\KeshavSingh-Packages-Core\src\KeshavSingh.Core\KeshavSingh.Core.csproj" />
  </ItemGroup>

</Project>
