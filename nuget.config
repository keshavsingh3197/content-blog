<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources. The private KeshavSingh.* packages come from GitHub Packages and need
  a read:packages token supplied via the PACKAGES_READ_TOKEN environment variable
  (never commit the token). Set it locally with `setx PACKAGES_READ_TOKEN <PAT>` and in
  each CI/deploy environment as a secret/env var.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/keshavsingh3197/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="keshavsingh3197" />
      <add key="ClearTextPassword" value="%PACKAGES_READ_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
